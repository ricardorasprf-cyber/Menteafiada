# ============================================================================
# Plataforma Educacional MenteAfiada - Regras de Exclusão Git (.gitignore)
# ============================================================================

# Dependências
node_modules/
/.pnp
.pnp.js

# Saídas de compilação Next.js e produção
.next/
out/
build/
dist/

# Ficheiros de registo (logs)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Variáveis de ambiente e ficheiros confidenciais
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ficheiros do sistema operativo e configurações de IDE
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Credenciais do Google Cloud / Supabase / Clerk
*credenciais*.json
*credentials*.json
scripts/*.json
!scripts/package.json
scripts/suas-credenciais-google.json
google-credentials.json
suas-credenciais-google.json

# Artefactos de consolidação da base de conhecimento da Gem
base_conhecimento_gem.md
temp_base.md